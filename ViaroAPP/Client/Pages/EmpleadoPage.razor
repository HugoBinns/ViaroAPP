@page "/"
@inject NotificationService NotificationService
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject DialogService DialogSerive

@using ViaroAPP.Shared
@using Radzen
@using Radzen.Blazor
@using ViaroAPP.Client.Pages.EmpleadosAssets

<PageTitle>Planilla</PageTitle>

<h2>Empleados</h2>

<RadzenRow>
    <RadzenColumn>
        <div class="grid-container shadow-sm">
            <!-- Contenedor con scroll controlado -->
            <RadzenDataGrid @ref="GridEmpleado" TItem="Empleado" AllowFiltering="true" AllowColumnResize="true"
            AllowPaging="true" PageSize="3" AllowSorting="true" Data="@empleado"
            SelectionMode="DataGridSelectionMode.Single"
            @bind-Value=@selected_empleado Style="width:100%;">
                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Nuevo empleado" Click="AbrirModalCrearEmpleado" />
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(Empleado.codigo)" Filterable="true" Title="Código Empleado" Frozen="true" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.nombre)" Filterable="true" Title="Nombre" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.segundoNombre)" Filterable="true" Title="Segundo Nombre" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.apellidoPaterno)" Filterable="true" Title="Apellido Paterno" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.apellidoMaterno)" Filterable="true" Title="Apellido Materno"/>
                    <RadzenDataGridColumn Property="@nameof(Empleado.salarioHora)" Filterable="true" Title="Salario Por Hora" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.idCargo)" Filterable="true" Title="Id Cargo"  />

                    <RadzenDataGridColumn Context="empleado" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="80px">
                        <Template Context="empleado">
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Click="@(args => EliminarEmpleado(empleado.codigo))" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" @onclick:stopPropagation="true">
                            </RadzenButton>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </RadzenColumn>
</RadzenRow>


@code {
    public RadzenDataGrid<Empleado> GridEmpleado;
    public List<Empleado> empleado = new List<Empleado>();
    public IList<Empleado> selected_empleado;

    //DataGridEditMode editMode =  DataGridEditMode.Single;

    //Funcion Principal
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var responseEmpleado = await Http.GetFromJsonAsync<List<Empleado>>("api/Empleados");
            empleado = responseEmpleado.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ObtenerEmpleados()
    {
        try
        {
            var responseEmpleado = await Http.GetFromJsonAsync<List<Empleado>>("api/Empleados");
            empleado = responseEmpleado.ToList();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task ObtenerEmpleadoPorCodigo(string codigo)
    {
        try
        {
            var responseEmpleado = await Http.GetFromJsonAsync<Empleado>($"api/Empleados/{codigo}");
            // Manejar el empleado obtenido
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }


    private async Task CrearEmpleado(Empleado nuevoEmpleado)
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Empleados", nuevoEmpleado);
            if (response.IsSuccessStatusCode)
            {
                await ObtenerEmpleados(); // Actualizar la lista de empleados
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", error);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private async Task ActualizarEmpleado(string codigo, Empleado empleadoActualizado)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Empleados/{codigo}", empleadoActualizado);
            if (response.IsSuccessStatusCode)
            {
                await ObtenerEmpleados(); // Actualizar la lista de empleados
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", error);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private async Task EliminarEmpleado(string codigo)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Empleados/{codigo}");
            if (response.IsSuccessStatusCode)
            {
                await ObtenerEmpleados(); // Actualizar la lista de empleados
                NotificationService.Notify(NotificationSeverity.Success, "Empleado Eliminado", $"El empleado con código {codigo} ha sido eliminado correctamente.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", error);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
    }


    private async void AbrirModalCrearEmpleado()
    {
        DialogSerive.Open<CrearEmpleados>("Crear Nuevo Empleado");
        await ObtenerEmpleados();
    }


}

