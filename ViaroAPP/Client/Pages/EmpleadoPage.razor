@page "/"
@inject NotificationService NotificationService
@inject HttpClient Http
@inject IJSRuntime JSRuntime

@using ViaroAPP.Shared
@using Radzen
@using Radzen.Blazor

<PageTitle>Planilla</PageTitle>

<h2>Empleados</h2>

<RadzenRow>
    <RadzenColumn>
        <div class="grid-container shadow-sm">
            <!-- Contenedor con scroll controlado -->
            <RadzenDataGrid @ref="GridEmpleado" TItem="Empleado" AllowFiltering="true" AllowColumnResize="true"
                                                       AllowPaging="true" PageSize="3" AllowSorting="true" Data="@empleado"
                                                       SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value=@selected_empleado EditMode="@editMode" Style="width:100%;">
                <HeaderTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Nuevo empleado" />
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(Empleado.codigo)" Filterable="true" Title="Código Empleado" Frozen="true" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.nombre)" Filterable="true" Title="Nombre" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.segundoNombre)" Filterable="true" Title="Segundo Nombre" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.apellidoPaterno)" Filterable="true" Title="Apellido Paterno" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.apellidoMaterno)" Filterable="true" Title="Apellido Materno"/>
                    <RadzenDataGridColumn Property="@nameof(Empleado.salarioHora)" Filterable="true" Title="Salario Por Hora" />
                    <RadzenDataGridColumn Property="@nameof(Empleado.idCargo)" Filterable="true" Title="Id Cargo"  />

                    <RadzenDataGridColumn Context="empleado" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="120px">
                        <Template Context="empleado">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" @onclick:stopPropagation="true"></RadzenButton>
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" @onclick:stopPropagation="true">
                            </RadzenButton>
                        </Template>
                        <EditTemplate Context="empleado">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" aria-label="Guardar">
                            </RadzenButton>
                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" aria-label="Cancelar">
                            </RadzenButton>
                            <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" aria-label="Delete">
                            </RadzenButton>
                        </EditTemplate>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </RadzenColumn>
</RadzenRow>


